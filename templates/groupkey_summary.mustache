{{!
    @template enrol_apply/groupkey_summary

    The groups of a course that carry an enrolment key, under the instance setting that decides
    whether such a key admits without review. The keys themselves are never in the context.

    Context variables required for this template:
    * hasgroups boolean - whether any group of the course carries a key
    * groups array - one object per keyed group, in id order:
      * name string - the group name, plain spelling
      * hasseats boolean - whether seats are known (local_groupdist is installed)
      * nolimit boolean - whether the group declares no seats
      * members int - current members
      * seats int - declared seats
      * full boolean - whether no seat is left, so the key admits nobody now
      * isshadowed boolean - whether another group shares this key and admits instead
      * shadowedby string - the name of that group, or empty
      * untypable boolean - whether the key starts or ends with a space
    * manageurl string - the course's groups page

    Example context (json):
    {
        "hasgroups": true,
        "groups": [
            {"name": "Turma A", "hasseats": true, "nolimit": false, "members": 12, "seats": 20,
             "full": false, "isshadowed": false, "shadowedby": "", "untypable": false},
            {"name": "Turma B", "hasseats": true, "nolimit": false, "members": 20, "seats": 20,
             "full": true, "isshadowed": false, "shadowedby": "", "untypable": false},
            {"name": "Turma C", "hasseats": true, "nolimit": true, "members": 8, "seats": 0,
             "full": false, "isshadowed": true, "shadowedby": "Turma A", "untypable": false}
        ],
        "manageurl": "https://example.com/group/index.php?id=2"
    }
}}
<div class="enrol_apply-groupkeys">
    {{#hasgroups}}
    <ul class="list-unstyled mb-1">
        {{#groups}}
        <li class="mb-1">
            <span class="fw-bold">{{name}}</span>
            {{#hasseats}}
                {{#nolimit}}
                    <span class="text-muted">&middot; {{#str}} groupseatsnolimit, enrol_apply, {{members}} {{/str}}</span>
                {{/nolimit}}
                {{^nolimit}}
                    <span class="text-muted">&middot; {{#str}} groupseatsof, enrol_apply, { "members": {{members}}, "seats": {{seats}} } {{/str}}</span>
                {{/nolimit}}
                {{#full}}
                    <span class="badge bg-warning text-dark">{{#str}} groupkeyadmitsnobody, enrol_apply {{/str}}</span>
                {{/full}}
            {{/hasseats}}
            {{#isshadowed}}
                <div class="small text-muted">{{#str}} groupkeyshadowed, enrol_apply, {{shadowedby}} {{/str}}</div>
            {{/isshadowed}}
            {{#untypable}}
                <div class="small text-muted">{{#str}} groupkeyuntypable, enrol_apply {{/str}}</div>
            {{/untypable}}
        </li>
        {{/groups}}
    </ul>
    {{/hasgroups}}
    {{^hasgroups}}
    <div class="alert alert-warning mb-1">{{#str}} groupkeysnone, enrol_apply {{/str}}</div>
    {{/hasgroups}}
    <a href="{{manageurl}}">{{#str}} groupkeysmanage, enrol_apply {{/str}}</a>
</div>
