{{!
    @template enrol_apply/field_conditions

    The "Display conditions" section of the application fields page: when each question an
    enrolment method asks is shown, with a link to change it and a button to remove it.

    Names and summaries are the plain spelling and are rendered through a double stash, so
    Mustache escapes each exactly once. Removing posts the sesskey; nothing here needs
    JavaScript.

    Context variables required for this template:
    * heading string - heading of the section
    * intro string - what a display condition does
    * hasrows bool - whether the method asks any question
    * rows array - one entry per question, in form order: name, summary, canedit, editurl,
      editlabel, hascondition, removelabel and fieldid
    * removeurl string - where a removal posts
    * enrolid int - the enrol instance id
    * sesskey string - the session key

    Example context (json):
    {
        "heading": "Display conditions",
        "intro": "A question can be shown only when an earlier drop-down menu or checkbox has a given answer.",
        "hasrows": true,
        "rows": [
            {"name": "Do you work in R&D?", "summary": "Always shown", "canedit": false, "editurl": "#",
             "editlabel": "Edit the display condition of Do you work in R&D?", "hascondition": false,
             "removelabel": "Remove the display condition of Do you work in R&D?", "fieldid": 3},
            {"name": "Team < 10 people", "summary": "Shown when \"Do you work in R&D?\" is checked", "canedit": true,
             "editurl": "#", "editlabel": "Edit the display condition of Team < 10 people", "hascondition": true,
             "removelabel": "Remove the display condition of Team < 10 people", "fieldid": 4}
        ],
        "removeurl": "#",
        "enrolid": 7,
        "sesskey": "abc123"
    }
}}
<div class="enrol_apply-field-conditions mt-4">
    <h3>{{heading}}</h3>
    <p>{{intro}}</p>
    {{#hasrows}}
    <table class="generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}}conditionquestion, enrol_apply{{/str}}</th>
                <th scope="col">{{#str}}conditionsummary, enrol_apply{{/str}}</th>
                <th scope="col">{{#str}}actions{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr>
                <th scope="row">{{name}}</th>
                <td>{{summary}}</td>
                <td>
                    {{#canedit}}
                    <a href="{{editurl}}" aria-label="{{editlabel}}">{{#str}}edit{{/str}}</a>
                    {{/canedit}}
                    {{#hascondition}}
                    <form method="post" action="{{removeurl}}" class="d-inline ms-2">
                        <input type="hidden" name="id" value="{{enrolid}}">
                        <input type="hidden" name="fieldid" value="{{fieldid}}">
                        <input type="hidden" name="action" value="remove">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button type="submit" class="btn btn-link p-0 align-baseline" aria-label="{{removelabel}}">{{#str}}conditionremove, enrol_apply{{/str}}</button>
                    </form>
                    {{/hascondition}}
                </td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
    {{/hasrows}}
    {{^hasrows}}
    <p>{{#str}}conditionsempty, enrol_apply{{/str}}</p>
    {{/hasrows}}
</div>
