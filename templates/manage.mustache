{{!
    @template enrol_apply/manage

    Decision form wrapping the table of pending enrolment applications.

    The table markup is produced by table_sql and passed in already rendered, so it is
    output with a triple stash. Everything else is escaped normally.

    Context variables required for this template:
    * formurl string - url the decision form posts back to
    * sesskey string - session key guarding the state change
    * tablehtml string - pre-rendered applications table
    * hasrows boolean - whether the table has at least one application
    * stickyfooter string - the bulk action bar, already rendered into a core sticky footer by
      the renderer and interpolated INSIDE this form, because the POST carries the row checkboxes
      from the table and the action from the bar. Core does the same in grade/templates/edit_tree
      and the sticky footer is never moved in the DOM - its placement is CSS, not JavaScript, so
      the inputs inside it post normally.
    * messagelabel string - label of the optional message to the applicant
    * messagehelp string - hint explaining who reads the message and when
    * hasgroups boolean - whether the course has any group to offer
    * grouplabel string - label of the group chooser
    * grouphelp string - hint explaining what choosing nothing does
    * groups array - list of id and name pairs, one per group in the course; each name is the
      plain spelling, because the option text is output through a double stash and Mustache
      escapes it there
    * hasroles boolean - whether the decider may assign any role in this course
    * rolelabel string - label of the role chooser
    * rolehelp string - hint explaining what choosing nothing does
    * roledefault string - text of the option that leaves the method's own role in charge
    * roles array - list of id and name pairs, one per role the decider may assign; each name is
      the ESCAPED spelling and is therefore output through a TRIPLE stash, exactly as core's own
      element-select.mustache does. get_assignable_roles() returns format_string() output and
      offers no way to ask for the plain spelling, so a double stash here would escape a second
      time and a role renamed with an ampersand would read wrongly.

    Example context (json):
    {
        "formurl": "https://example.com/enrol/apply/manage.php?id=7",
        "sesskey": "Ab12Cd34Ef",
        "tablehtml": "<table class=\"generaltable\"><tbody><tr><td>Student 1</td></tr></tbody></table>",
        "hasrows": true,
        "stickyfooter": "<div id=\"sticky-footer\"><button type=\"submit\">Go</button></div>",
        "messagelabel": "Message to the applicant",
        "messagehelp": "Included in the message they receive. Optional.",
        "hasgroups": true,
        "grouplabel": "Groups to join on approval",
        "grouphelp": "Leave empty to use the groups configured on the enrolment method.",
        "groups": [
            {"id": 3, "name": "Tutorial A"},
            {"id": 4, "name": "R&D < Team"}
        ],
        "hasroles": true,
        "rolelabel": "Role to assign on approval",
        "rolehelp": "Leave it alone to use the role configured on the enrolment method.",
        "roledefault": "Use the enrolment method's role",
        "roles": [
            {"id": 5, "name": "Student"},
            {"id": 3, "name": "R&amp;D &lt; Team"}
        ]
    }
}}
<form id="enrol_apply_manage_form" class="enrol_apply-manage" method="post" action="{{formurl}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <div class="enrol_apply-table">
        {{{tablehtml}}}
    </div>
    {{#hasrows}}
        {{#hasgroups}}
            <div class="enrol_apply-decisiongroups mt-3">
                <label class="form-label" for="enrol_apply_groups">{{grouplabel}}</label>
                <select class="form-select" id="enrol_apply_groups" name="groups[]" multiple
                    aria-describedby="enrol_apply_groups_help">
                    {{#groups}}
                        <option value="{{id}}">{{name}}</option>
                    {{/groups}}
                </select>
                <div class="form-text" id="enrol_apply_groups_help">{{grouphelp}}</div>
            </div>
        {{/hasgroups}}
        {{#hasroles}}
            <div class="enrol_apply-decisionrole mt-3">
                <label class="form-label" for="enrol_apply_roleid">{{rolelabel}}</label>
                <select class="form-select" id="enrol_apply_roleid" name="roleid"
                    aria-describedby="enrol_apply_roleid_help">
                    <option value="0">{{roledefault}}</option>
                    {{#roles}}
                        <option value="{{id}}">{{{name}}}</option>
                    {{/roles}}
                </select>
                <div class="form-text" id="enrol_apply_roleid_help">{{rolehelp}}</div>
            </div>
        {{/hasroles}}
        <div class="enrol_apply-outcomemessage mt-3">
            <label class="form-label" for="enrol_apply_outcomemessage">{{messagelabel}}</label>
            <textarea class="form-control" id="enrol_apply_outcomemessage" name="outcomemessage"
                rows="3" aria-describedby="enrol_apply_outcomemessage_help"></textarea>
            <div class="form-text" id="enrol_apply_outcomemessage_help">{{messagehelp}}</div>
        </div>
        {{{stickyfooter}}}
    {{/hasrows}}
</form>
